# --- Sunucu / Server ---
PORT=3000
NODE_ENV=development
# Sunucunun dışarıdan görünen adresi (snippet, admin linki ve PDF rehberi bunu kullanır)
# Public URL of this install (used by the snippet, admin links and PDF guides)
PUBLIC_URL=http://localhost:3000
# Uzun ve rastgele bir değer üretin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Reverse proxy (Caddy/Nginx) arkasındaysanız 1 yapın / set to 1 behind a reverse proxy
TRUST_PROXY=0
# Veritabanı ve yüklemeler / database and uploads
DATA_DIR=./data
# examples/ klasörünü /examples altında yayınla (demo için) / serve demo pages under /examples
SERVE_EXAMPLES=true

# --- Hız sınırları / Rate limits ---
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MIN=10
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MIN=15

# --- Yükleme / Uploads ---
UPLOAD_MAX_MB=5

# --- E-posta bildirimi (SMTP) / Email notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="landing-kit <bildirim@ornek.com>"

# --- Telegram bildirimi (opsiyonel) / Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
# Site bazında chat id yoksa buraya gider / fallback chat id when a site has none
TELEGRAM_DEFAULT_CHAT_ID=

# --- Freelancer destek bilgisi (PDF rehberde görünür) / support contact shown in PDF guides ---
SUPPORT_NAME=Poyraz Avsever
SUPPORT_PHONE=+90 5xx xxx xx xx
SUPPORT_EMAIL=destek@ornek.com

# --- PDF ---
# Playwright Chromium yoksa kullanılacak tarayıcı yolu (Chrome/Edge) / browser to use if Playwright Chromium is missing
PDF_BROWSER_PATH=
